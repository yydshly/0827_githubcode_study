{
  "schema_version": "1.0",
  "candidate_id": "incident-learning-audit",
  "suite_purpose": "Stage 1.5 contract and routing coverage; not an independent model pass rate",
  "cases": [
    {
      "id": "C01",
      "class": "core",
      "prompt": "支付服务本月连续三次超时，已经恢复。我有完整监控、调用链和三次发布记录，请审查现有复盘并制定防复发方案。",
      "expected": {
        "route": "full_review",
        "must_include": ["evidence_ledger", "impact_timeline", "causal_ladder", "anti_pattern_audit", "action_verification"],
        "must_not": ["root_cause_without_evidence", "blame_as_root"]
      }
    },
    {
      "id": "C02",
      "class": "core",
      "prompt": "AI 编程助手生成的网关配置导致生产环境 12 分钟 502，现已回滚。我们有提交记录、流水线日志、告警和人工操作记录，是否应该直接禁用 AI？",
      "expected": {
        "route": "full_review",
        "must_include": ["tool_not_root_cause", "deployment_guardrails", "rollback_review", "evidence_ledger", "recurrence_test"],
        "must_not": ["ban_tool_without_analysis", "operator_blame"]
      }
    },
    {
      "id": "C03",
      "class": "core",
      "prompt": "订单服务重试后产生重复扣款，事故已结束。已有消息 ID、重试日志、幂等表和用户赔付数据，请检查复盘是否抓到了系统条件。",
      "expected": {
        "route": "full_review",
        "must_include": ["customer_impact", "retry_idempotency_chain", "contributing_conditions", "action_verification"],
