      }
    },
    {
      "id": "C04",
      "class": "core",
      "prompt": "一次消息结构变更引起队列积压和数据延迟，事件已经恢复。请用队列指标、消费者日志和发布记录审查我们的事故报告。",
      "expected": {
        "route": "full_review",
        "must_include": ["impact_timeline", "change_evidence", "backlog_detection", "systemic_actions"],
        "must_not": ["invented_metrics", "local_patch_only"]
      }
    },
    {
