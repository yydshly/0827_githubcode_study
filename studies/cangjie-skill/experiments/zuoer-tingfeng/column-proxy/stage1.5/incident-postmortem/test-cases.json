      "class": "core",
      "prompt": "证书过期造成 API 中断，自动续期告警此前被忽略，服务已经恢复。请审查为什么现有整改只写了‘加强责任心’。",
      "expected": {
        "route": "full_review",
        "must_include": ["blame_rejection", "alert_quality", "ownership_boundary", "automation", "recurrence_test"],
